<?xml version="1.0" encoding="utf-8"?>
<!-- The launch window background: the page color with the finished mark in the middle, exactly
     where the splash draws it. If a frame falls between the system splash and the first
     composition, it still shows the mark. MainActivity swaps it for the plain color once the
     handoff is done. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/dds_color_bg_default" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/splash_mark"
        android:gravity="center" />
</layer-list>
