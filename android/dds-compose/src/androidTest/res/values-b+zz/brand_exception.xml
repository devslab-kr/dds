<?xml version="1.0" encoding="utf-8"?>
<!-- BrandResourcesTest, product A. A made-up locale ("zz") stands in for an app's
     own res/values, so these overrides reach only the test that asks for that
     locale and every other device test keeps the DDS brand.
     White text on an orange fill is about 2.4:1; the product declares the
     exception once, in "values" only. -->
<resources>
    <color name="dds_color_bg_brand">@android:color/holo_orange_dark</color>
    <color name="dds_color_text_on_brand">@android:color/white</color>
    <bool name="dds_allow_contrast_text_on_brand">true</bool>
</resources>
