{
  "name": "@devslab/dds-icons",
  "version": "0.5.2",
  "description": "DDS icon set — one SVG source (24 grid, currentColor), shipped as files, a sprite and a path-data map",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/devslab-kr/dds.git",
    "directory": "packages/dds-icons"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "direction-policy.json"
  ],
  "main": "./dist/icons.js",
  "types": "./dist/icons.d.ts",
  "exports": {
    ".": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./icons.svg": "./dist/icons.svg",
    "./direction-policy.json": "./direction-policy.json",
    "./svg/*": "./dist/svg/*"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node scripts/check-icons.mjs"
  },
  "homepage": "https://devslab.kr/brand/",
  "bugs": {
    "url": "https://github.com/devslab-kr/dds/issues"
  },
  "keywords": [
    "icons",
    "svg",
    "sprite",
    "design-system",
    "devslab"
  ]
}
