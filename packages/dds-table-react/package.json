{
  "name": "@devslab/dds-table-react",
  "version": "0.28.0",
  "description": "DDS themed Community AG Grid for React",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/devslab-kr/dds.git",
    "directory": "packages/dds-table-react"
  },
  "homepage": "https://devslab.kr/brand/",
  "bugs": {
    "url": "https://github.com/devslab-kr/dds/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly && node build-css.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.ssr.config.ts"
  },
  "dependencies": {
    "@devslab/dds-css": "workspace:0.28.0",
    "@devslab/dds-tokens": "workspace:0.28.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.3.0",
    "@testing-library/react": "16.3.2",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.1"
  },
  "keywords": [
    "react",
    "ag-grid",
    "table",
    "design-system",
    "devslab"
  ]
}
