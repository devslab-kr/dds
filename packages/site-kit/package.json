{
  "name": "@devslab/site-kit",
  "version": "0.21.0",
  "description": "Strict i18n, SEO/GEO, and React/Solid public-site chrome for DevsLab products",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "sideEffects": [
    "./styles.css",
    "./site-sections.css",
    "./fonts.css",
    "./react-chrome.css",
    "./chrome-tokens.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/devslab-kr/dds.git",
    "directory": "packages/site-kit"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "flags",
    "fonts",
    "src/core",
    "src/tanstack-start.mjs",
    "src/tanstack-start.d.mts",
    "styles.css",
    "site-sections.css",
    "fonts.css",
    "README.md",
    "README.ko.md",
    "react-chrome.css",
    "brand",
    "scripts/sync-brand.mjs",
    "chrome-tokens.css"
  ],
  "main": "./src/core/index.mjs",
  "types": "./src/core/index.d.mts",
  "exports": {
    "./devslab": {
      "types": "./src/core/devslab.d.mts",
      "import": "./src/core/devslab.mjs"
    },
    ".": {
      "types": "./src/core/index.d.mts",
      "import": "./src/core/index.mjs"
    },
    "./flags": {
      "types": "./src/core/flags.d.mts",
      "import": "./src/core/flags.mjs"
    },
    "./solid": {
      "types": "./dist/index.d.ts",
      "worker": "./dist/solid.server.js",
      "workerd": "./dist/solid.server.js",
      "node": "./dist/solid.server.js",
      "browser": "./dist/solid.js",
      "default": "./dist/solid.js"
    },
    "./tanstack-start": {
      "types": "./src/tanstack-start.d.mts",
      "import": "./src/tanstack-start.mjs"
    },
    "./styles.css": "./styles.css",
    "./site-sections.css": "./site-sections.css",
    "./fonts.css": "./fonts.css",
    "./fonts/*": "./fonts/*",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react-chrome.css": "./react-chrome.css",
    "./brand/*": "./brand/*",
    "./sync-brand": "./scripts/sync-brand.mjs"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.server.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly && tsc -p tsconfig.react.json",
    "check": "node scripts/build-flags.mjs --check && node scripts/build-fonts.mjs --check && tsc -p tsconfig.json --noEmit && tsc -p fixtures/bundle-probe/tsconfig.json && node scripts/check-client-bundle.mjs",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.ssr.config.ts",
    "test:a11y": "vitest run --config vitest.config.ts src/solid/__tests__/a11y.test.tsx",
    "test:worker": "wrangler deploy --dry-run --config fixtures/worker/wrangler.jsonc --outdir dist-worker",
    "test:react": "vitest run --config vitest.react.config.ts"
  },
  "dependencies": {
    "@devslab/dds-solid": "workspace:0.21.0"
  },
  "peerDependencies": {
    "@tanstack/solid-router": "1.170.30",
    "@tanstack/solid-start": "1.168.47",
    "solid-js": "1.9.15",
    "react": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/solid-router": {
      "optional": true
    },
    "@tanstack/solid-start": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/solid-router": "1.170.30",
    "@tanstack/solid-start": "1.168.47",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "26.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "solid-js": "1.9.15",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.1",
    "wrangler": "4.127.1"
  },
  "homepage": "https://devslab.kr/brand/",
  "bugs": {
    "url": "https://github.com/devslab-kr/dds/issues"
  },
  "keywords": [
    "solidjs",
    "i18n",
    "seo",
    "design-system",
    "devslab"
  ]
}
