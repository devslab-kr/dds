{
  "name": "@devslab/site-kit",
  "version": "0.2.3",
  "description": "Strict i18n, SEO/GEO, and Solid public-site shells for DevsLab products",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "./styles.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/devslab-kr/dds.git",
    "directory": "packages/site-kit"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "restricted",
    "provenance": false
  },
  "files": [
    "dist",
    "src/core",
    "src/tanstack-start.mjs",
    "src/tanstack-start.d.mts",
    "styles.css",
    "README.md",
    "README.ko.md"
  ],
  "main": "./src/core/index.mjs",
  "types": "./src/core/index.d.mts",
  "exports": {
    ".": {
      "types": "./src/core/index.d.mts",
      "import": "./src/core/index.mjs"
    },
    "./solid": {
      "types": "./dist/index.d.ts",
      "import": "./dist/solid.js"
    },
    "./tanstack-start": {
      "types": "./src/tanstack-start.d.mts",
      "import": "./src/tanstack-start.mjs"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.ssr.config.ts",
    "test:a11y": "vitest run --config vitest.config.ts src/solid/__tests__/a11y.test.tsx",
    "test:worker": "wrangler deploy --dry-run --config fixtures/worker/wrangler.jsonc --outdir dist-worker"
  },
  "dependencies": {
    "@devslab/dds-solid": "workspace:0.2.3"
  },
  "peerDependencies": {
    "@tanstack/solid-router": "1.170.30",
    "@tanstack/solid-start": "1.168.47",
    "solid-js": "1.9.15"
  },
  "peerDependenciesMeta": {
    "@tanstack/solid-router": {
      "optional": true
    },
    "@tanstack/solid-start": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "@tanstack/solid-router": "1.170.30",
    "@tanstack/solid-start": "1.168.47",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "solid-js": "1.9.15",
    "@testing-library/jest-dom": "6.9.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.1",
    "wrangler": "4.127.1"
  }
}
