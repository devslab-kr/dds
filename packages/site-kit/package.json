{
  "name": "@devslab/site-kit",
  "version": "0.2.0",
  "description": "Strict i18n, SEO/GEO, and Solid public-site shells for DevsLab products",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": ["./styles.css"],
  "repository": { "type": "git", "url": "https://github.com/devslab-kr/dds.git", "directory": "packages/site-kit" },
  "publishConfig": { "registry": "https://registry.npmjs.org/", "access": "restricted", "provenance": true },
  "files": ["dist", "src/core", "src/tanstack-start.mjs", "src/tanstack-start.d.ts", "styles.css", "README.md", "README.ko.md"],
  "main": "./src/core/index.mjs",
  "types": "./src/core/index.d.ts",
  "exports": {
    ".": { "types": "./src/core/index.d.ts", "import": "./src/core/index.mjs" },
    "./solid": { "types": "./dist/solid.d.ts", "import": "./dist/solid.js" },
    "./tanstack-start": { "types": "./src/tanstack-start.d.ts", "import": "./src/tanstack-start.mjs" },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:a11y": "vitest run --config vitest.config.ts src/solid/__tests__/a11y.test.tsx",
    "test:worker": "wrangler deploy --dry-run --config fixtures/worker/wrangler.jsonc --outdir dist-worker"
  },
  "dependencies": { "@devslab/dds-solid": "0.2.0" },
  "peerDependencies": {
    "@solidjs/web": "2.0.0-rc.3",
    "@tanstack/solid-router": "2.0.0-rc.3",
    "@tanstack/solid-start": "2.0.0-rc.3",
    "solid-js": "2.0.0-rc.3"
  },
  "peerDependenciesMeta": {
    "@tanstack/solid-router": { "optional": true },
    "@tanstack/solid-start": { "optional": true }
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.32",
    "@solidjs/web": "2.0.0-rc.3",
    "@tanstack/solid-router": "2.0.0-rc.3",
    "@tanstack/solid-start": "2.0.0-rc.3",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "solid-js": "2.0.0-rc.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.1",
    "wrangler": "4.123.0"
  }
}
