{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve", "jsxImportSource": "solid-js", "strict": true,
    "exactOptionalPropertyTypes": true, "noUncheckedIndexedAccess": true,
    "allowJs": true, "checkJs": false, "isolatedModules": true, "skipLibCheck": true, "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.mts", "vite.config.ts", "vitest.config.ts"]
}
