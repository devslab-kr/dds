{
  "name": "@devslab/dds-solid",
  "version": "0.2.2",
  "description": "Accessible SolidJS primitives for the DevsLab Design System",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "./styles.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/devslab-kr/dds.git",
    "directory": "packages/dds-solid"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "restricted",
    "provenance": true
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "README.ko.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "worker": "./dist/server.js",
      "node": "./dist/server.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.server.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.ssr.config.ts",
    "test:a11y": "vitest run --config vitest.config.ts src/__tests__/a11y.test.tsx"
  },
  "dependencies": {
    "@devslab/dds-css": "workspace:0.2.2",
    "@devslab/dds-icons": "workspace:0.2.2",
    "@devslab/dds-tokens": "workspace:0.2.2"
  },
  "peerDependencies": {
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "solid-js": "1.9.15",
    "@testing-library/jest-dom": "6.9.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.1"
  }
}
