{
  "name": "@devslab/dds-react",
  "version": "0.21.2",
  "description": "Accessible React primitives for the DevsLab Design System",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "sideEffects": [
    "./styles.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/devslab-kr/dds.git",
    "directory": "packages/dds-react"
  },
  "homepage": "https://devslab.kr/brand/",
  "bugs": {
    "url": "https://github.com/devslab-kr/dds/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "README.ko.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && vitest run --config vitest.ssr.config.ts",
    "test:a11y": "vitest run src/__tests__/a11y.test.tsx"
  },
  "dependencies": {
    "@ark-ui/react": "5.39.3",
    "@devslab/dds-css": "workspace:0.21.2",
    "@devslab/dds-icons": "workspace:0.21.2",
    "@devslab/dds-tokens": "workspace:0.21.2"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "26.3.0",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.1"
  },
  "keywords": [
    "react",
    "components",
    "accessibility",
    "design-system",
    "devslab"
  ]
}
