{
  "name": "@devslab/compatibility-canary",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run generate:routes && node scripts/run-clean.mjs vite build && node scripts/scan-build.mjs",
    "generate:routes": "tsr generate",
    "preview": "vite preview",
    "preview:framework:smoke": "node scripts/preview-smoke.mjs",
    "binding:smoke": "node scripts/binding-smoke.mjs",
    "preview:smoke": "pnpm run preview:framework:smoke && pnpm run binding:smoke",
    "test": "node --test tests/contracts.test.mjs tests/application-contracts.test.mjs",
    "typecheck": "pnpm run generate:routes && node scripts/run-clean.mjs tsc --noEmit",
    "verify:dependencies": "node scripts/verify-install.mjs && node scripts/verify-dependencies.mjs"
  },
  "dependencies": {
    "@tanstack/solid-query": "5.102.8",
    "@tanstack/solid-router": "1.170.30",
    "@tanstack/solid-start": "1.168.47",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@playwright/test": "1.62.1",
    "@tanstack/router-cli": "1.167.33",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-solid": "2.11.14",
    "wrangler": "4.127.1"
  }
}
