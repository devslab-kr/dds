{
  "name": "@devslab/dds-svelte",
  "version": "0.29.2",
  "description": "Svelte 5 ConsoleShell for the DevsLab Design System",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "sideEffects": [
    "./styles.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/devslab-kr/dds.git",
    "directory": "packages/dds-svelte"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "README.ko.md"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "dependencies": {
    "@devslab/dds-css": "workspace:*",
    "@devslab/dds-tokens": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.46.4"
  },
  "devDependencies": {
    "svelte": "5.57.2",
    "@sveltejs/package": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.1",
    "jsdom": "30.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/user-event": "14.6.1",
    "axe-core": "4.13.0"
  },
  "scripts": {
    "build": "svelte-package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run && vitest run --config vitest.ssr.config.ts"
  }
}
