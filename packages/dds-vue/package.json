{
  "name": "@devslab/dds-vue",
  "version": "0.28.0",
  "description": "Ark UI based Vue 3 components for the DevsLab Design System",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/devslab-kr/dds.git",
    "directory": "packages/dds-vue"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "README.ko.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./date-only": {
      "types": "./dist/dateOnly.d.ts",
      "import": "./dist/date-only.js"
    },
    "./styles.css": "./styles.css",
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./combobox": {
      "types": "./dist/combobox.d.ts",
      "import": "./dist/combobox.js"
    },
    "./select-picker": {
      "types": "./dist/select-picker.d.ts",
      "import": "./dist/select-picker.js"
    },
    "./dropdown-menu": {
      "types": "./dist/dropdown-menu.d.ts",
      "import": "./dist/dropdown-menu.js"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "import": "./dist/popover.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "import": "./dist/calendar.js"
    },
    "./date-picker": {
      "types": "./dist/date-picker.d.ts",
      "import": "./dist/date-picker.js"
    },
    "./date-range-picker": {
      "types": "./dist/date-range-picker.d.ts",
      "import": "./dist/date-range-picker.js"
    },
    "./month-picker": {
      "types": "./dist/month-picker.d.ts",
      "import": "./dist/month-picker.js"
    },
    "./time-picker": {
      "types": "./dist/time-picker.d.ts",
      "import": "./dist/time-picker.js"
    },
    "./segmented-control": {
      "types": "./dist/segmented-control.d.ts",
      "import": "./dist/segmented-control.js"
    },
    "./number-input": {
      "types": "./dist/number-input.d.ts",
      "import": "./dist/number-input.js"
    }
  },
  "dependencies": {
    "@ark-ui/vue": "5.39.3",
    "@devslab/dds-css": "workspace:0.28.0",
    "@devslab/dds-icons": "workspace:0.28.0",
    "@devslab/dds-tokens": "workspace:0.28.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "vue": "3.5.39",
    "@vitejs/plugin-vue": "6.0.7",
    "vite": "7.3.6",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.6",
    "vitest": "4.1.9",
    "@vue/test-utils": "2.4.6",
    "jsdom": "30.0.1",
    "axe-core": "4.13.0"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "check": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
