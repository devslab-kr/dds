{
  "name": "@devslab-kr/dds-email-template",
  "version": "0.1.0",
  "description": "Brand-configurable transactional email HTML and plain-text renderer for Node and Workers",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/devslab-kr/dds.git",
    "directory": "packages/dds-email-template"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/preview.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:consumer": "node scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
